# --- Speechmatics real-time transcription ---
SPEECHMATICS_API_KEY=your-speechmatics-api-key
# EU endpoint by default; use wss://us.rt.speechmatics.com/v2 for US.
SPEECHMATICS_URL=wss://eu2.rt.speechmatics.com/v2
LANGUAGE=de

# --- OpenAI (GPT-5) for the "is this worth learning?" step ---
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5

# --- Audio capture ---
# Sample rate sent to Speechmatics (Hz). 16000 is a good default.
SAMPLE_RATE=16000
# Substring matched against the input device name, or a numeric device index.
# Leave empty to use the default input device. On WSLg the system-audio
# monitor source usually contains "monitor" in its name.
# Run `python -m transcript_learner --list-devices` to see the options.
AUDIO_DEVICE=

# --- Web server ---
HOST=127.0.0.1
PORT=8000

# Where finished session results (JSON) are written.
OUTPUT_DIR=sessions
