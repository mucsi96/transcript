# Copy to .env (git-ignored) and fill in.

# GET endpoint returning your known German words. Accepted JSON shapes:
#   ["laufen", "Haus"]
#   {"words": ["laufen", "Haus"]}
#   [{"word": "laufen"}, {"lemma": "Haus"}]
KNOWN_WORDS_API_URL=https://example.com/api/known-words

# Sent as "Authorization: Bearer <token>".
KNOWN_WORDS_API_TOKEN=your-secret-token
