# Copy to .env (git-ignored) and fill in.

# GET endpoint returning your known German words. Accepted JSON shapes:
#   ["laufen", "Haus"]
#   {"words": ["laufen", "Haus"]}
#   [{"word": "laufen"}, {"lemma": "Haus"}]
# Give the full endpoint path, not the site root: a root URL usually serves
# the web app's HTML page, which is not a word list.
KNOWN_WORDS_API_URL=https://example.com/api/known-cards?groupId=german

# Sent as "Authorization: Bearer <token>".
KNOWN_WORDS_API_TOKEN=your-secret-token

# OpenAI API key for the per-sentence word-extraction stage (`words`).
OPENAI_API_KEY=sk-your-key
